# ============================
# SElf - Railway Env Example
# ============================
# این فایل رو کپی کن به .env و مقادیر خودت رو بذار
# در ریلوی هم همین مقادیر رو در تب Variables بذار

# --- ضروری ---
# از my.telegram.org بگیر
API_ID=12345678
API_HASH=your_api_hash_here

# آیدی عددی خودت (از @userinfobot بگیر)
# اگر خالی باشه از 'me' استفاده میشه (یعنی خود اکانت)
OWNER_ID=123456789

# --- اختیاری ولی پیشنهادی ---
# پسورد برای ورود به داشبورد مدیریتی (خیلی مهم برای امنیت!)
ADMIN_PASSWORD=your_strong_password_here

# سشن استرینگ (اگر داری، دیگه نیازی به فایل سشن نیست)
# با این راحت تر روی ریلوی ران میشه
# برای گرفتنش یک بار بات رو لوکال ران کن و از لاگ بردار یا از @SessionStringBot بگیر
SESSION_STRING=

# نام فایل سشن (پیشفرض my_account)
SESSION_NAME=my_account

# توکن ربات (اگر میخوای به عنوان ربات هم ران کنی - اختیاری)
# برای سلف اصلی لازم نیست
BOT_TOKEN=

# آیا بات خودکار با داشبورد روشن بشه؟ (true/false)
AUTO_START_BOT=true

# پورت (ریلوی خودش میده، دست نزن)
PORT=8000
