# Cloudflare Worker/Container runtime values
# Never commit real secrets to GitHub, even when the repository is private.

API_ID=
API_HASH=
OWNER_ID=

# Strong random password for the web admin panel.
ADMIN_PASSWORD=

# Pyrogram user session string. Keep this only in Cloudflare Secrets.
SESSION_STRING=

SESSION_NAME=my_account
AUTO_START_BOT=true
